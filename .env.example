# Skopiuj do `.env` w tym samym katalogu co `docker-compose.yml`.
# Docker Compose używa `.env` do podstawienia zmiennych w pliku compose (nie mylić z przekazaniem do kontenera — tu wartości są jawnie mapowane w `environment`).

# Połączenie async (SQLAlchemy + asyncpg) z bazą PostgreSQL/PostGIS.
# Użytkownik/hasło/baza muszą być zgodne z serwisem `db` w docker-compose.
DATABASE_URL=postgresql+asyncpg://loadmax:loadmax@db:5432/loadmax

# Redis — cache / kolejki (numer bazy `/0` na końcu).
REDIS_URL=redis://redis:6379/0

# OSRM — routing HGV w backendzie (app/lib/osrm.py).
# Lokalny serwer OSRM na hoście :5001 (docker-compose maps 5001→5000 wewnątrz kontenera).
OSRM_HOST=http://host.docker.internal:5001

# Profil OSRM: "truck" (truck.lua — respektuje ograniczenia HGV) lub "driving" (car.lua).
# Wymaga przebudowania danych OSM z odpowiednim profilem — patrz CONTRIBUTING.md.
OSRM_PROFILE=truck

# Plik OSRM do uruchomienia w docker-compose (bez rozszerzenia .osrm):
# Dev: poland-latest | Prod: europe-latest | Inne: np. germany-latest
OSRM_FILE=poland-latest

# Cena paliwa używana w kalkulacji kosztów trasy (EUR za litr).
FUEL_PRICE_EUR_PER_LITER=1.75

# Dzienna dieta kierowcy w modelu kosztów (EUR / dzień roboczy).
DRIVER_DAILY_ALLOWANCE_EUR=49.0

# Koszt czasowy jednego przystanku (minuty — np. załadunek/rozładunek).
STOP_COST_MINUTES=30

# Twarde ograniczenie liczby przystanków w jednej trasie w solverze / API.
MAX_STOPS_PER_ROUTE=12

# Współczynnik wpływu masy na spalanie (np. 0.30 = +30% przy pełnym obciążeniu względem bazy).
WEIGHT_FUEL_FACTOR=0.30

# Koszt eksploatacji pojazdu przeliczany na kilometr (EUR / km).
MAINTENANCE_EUR_PER_KM=0.08
