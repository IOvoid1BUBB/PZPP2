{
  "name": "loadmax-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "echo \"Use: docker compose up -d --build (frontend runs in Docker, not next dev on host)\" && exit 1",
    "dev:local": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
